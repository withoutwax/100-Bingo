rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Room rules
    match /rooms/{roomId} {
      // Allow everyone to read and create rooms
      allow read, create: if true;
      
      // Update rules for room metadata
      // Since we removed Auth, we can't strictly verify the host.
      // We allow updates that match the logical state changes.
      allow update: if true;

      // Sub-collection: players
      match /players/{playerId} {
        // Allow everyone to see players and join
        allow read, create: if true;
        
        // Allow updates and deletes (honesty-based since we can't verify identity on server)
        allow update, delete: if true;
      }
    }
  }
}
